   "notes_by_num": {
    "1": "Partial. Not supported inside the `<body>`.",
    "2": "Partial. Not supported with non Google accounts.",
    "3": "Buggy. The first `<head>` in the HTML is removed, so `<style>` elements need to be in a second `<head>` element.",
