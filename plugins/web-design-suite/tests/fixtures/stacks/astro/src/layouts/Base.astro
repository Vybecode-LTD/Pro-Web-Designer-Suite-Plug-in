---
// The global entry: Astro puts imported styles before every scoped style, so
// index.css, which states the layer order, is the first to name a layer.
import '../styles/index.css';

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
